{
  "manifest_version": 3,
  "name": "Awesome Input",
  "version": "0.1.1",
  "description": "Enterで改行、Cmd/Ctrl+Enterで送信する入力支援拡張。",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "types.js",
        "utils.js",
        "composer.js",
        "send.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
