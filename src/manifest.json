{
  "manifest_version": 3,
  "name": "Awesome Input",
  "version": "0.1.0",
  "version_name": "v0.1.0",
  "description": "Input helper extension that inserts newlines with Enter and sends with Cmd/Ctrl+Enter.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "types.js",
        "utils.js",
        "dom.js",
        "adapters/base.js",
        "adapters/chatgpt.js",
        "adapters/gemini.js",
        "adapters/index.js",
        "composer.js",
        "send.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
