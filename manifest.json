{
  "manifest_version": 3,
  "name": "ChatGPT Keyflow",
  "version": "0.1.1",
  "description": "Enterで改行、Cmd/Ctrl+Enterで送信。Ctrl+Gで複数入力ポップアップを開く ChatGPT 用拡張。",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
